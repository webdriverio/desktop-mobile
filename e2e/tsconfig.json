{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/visual-service",
      "mocha"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ]
  },
  "include": [
    "./test/**/*.spec.ts"
  ],
  "exclude": []
}
