{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/visual-service",
      "@wdio/native-types",
      "mocha"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ]
  },
  "include": [
    "./config/**/*.ts",
    "./lib/**/*.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
    "./wdio*.conf.ts"
  ],
  // CI runs show-logs.ts on bare node, so tsconfig.scripts.json checks it under type-stripping rules.
  "exclude": [
    "./scripts/show-logs.ts"
  ]
}
