{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/visual-service",
      "@wdio/native-types",
      "mocha"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ]
  },
  "include": [
    "./lib/**/*.ts",
    "./test/**/*.ts",
    "./wdio*.conf.ts"
  ],
  // Node-only code, which tsconfig.node.json checks without the DOM lib or test globals. Specs and
  // configs still import some of it, which pulls those files back into this program.
  "exclude": [
    "./lib/display.ts",
    "./lib/statusBar.ts",
    "./lib/utils.ts"
  ]
}
