# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]

indent_style = space
indent_size = 4

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{**/*.json,.github/**/*.yml}]
indent_size = 2

# Tauri codegen writes these byte-for-byte and skips the write only when the file
# already matches exactly (serde_json::to_string_pretty / to_string, neither of which
# emits a final newline, handed to write_if_changed). Adding one on save makes every
# cargo build rewrite the file, which is how the drift these paths keep showing up in
# got introduced in the first place.
# Scoped to the generated subdirectories only — permissions/default.toml next door is
# hand-written and must keep its final newline. Same paths biome.jsonc already ignores.
[packages/tauri-plugin*/permissions/{schemas,autogenerated}/**]
insert_final_newline = false

[**/src-tauri/gen/schemas/**]
insert_final_newline = false
