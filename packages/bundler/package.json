{
  "name": "@wdio/bundler",
  "version": "0.0.0",
  "description": "Build tool for WebdriverIO packages",
  "homepage": "https://github.com/webdriverio/desktop-mobile/tree/main/packages/bundler",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wdio-bundler": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "clean": "pnpm clean:dist && pnpm dlx shx rm -rf ./node_modules pnpm-lock.yaml",
    "clean:dist": "pnpm dlx shx rm -rf ./dist",
    "dev": "pnpm run build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "shx rm -rf dist && rollup --config rollup.config.ts --configPlugin typescript",
    "build:debug": "cross-env DEBUG=@wdio/bundler pnpm build",
    "test:unit": "vitest --coverage --watch=false test/unit/",
    "test:integration": "vitest --watch=false test/integration/",
    "test:dev": "vitest --coverage",
    "test": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "commander": "^15.0.0",
    "debug": "^4.4.3",
    "find-up-simple": "^1.0.1",
    "rollup": "^4.62.4",
    "rollup-plugin-node-externals": "^9.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "shx": "^0.4.0",
    "terser": "^5.50.0",
    "tsx": "^4.23.5",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/webdriverio/desktop-mobile-testing.git",
    "directory": "packages/bundler"
  }
}
