{
  "name": "@wdio/native-types",
  "version": "3.0.0",
  "description": "Type definitions for WebdriverIO Native Desktop Services (Electron and Tauri)",
  "homepage": "https://github.com/webdriverio/desktop-mobile/tree/main/packages/native-types",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": [
      {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./dist/cjs/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "shx rm -rf dist coverage .turbo",
    "build": "node ../../scripts/build-package.ts",
    "dev": "node ../../scripts/build-package.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@wdio/bundler": "workspace:*",
    "@wdio/globals": "catalog:default",
    "@wdio/native-spy": "workspace:*",
    "@wdio/types": "catalog:default",
    "builder-util": "^26.16.0",
    "electron": "catalog:default",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "webdriverio": "catalog:default"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webdriverio/desktop-mobile.git",
    "directory": "packages/native-types"
  },
  "peerDependencies": {
    "@wdio/types": "^9.0.0 || ^10.0.0",
    "webdriverio": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@wdio/types": {
      "optional": true
    },
    "webdriverio": {
      "optional": true
    }
  }
}
