{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/cjs",
    "node_modules",
    "coverage",
    "dist",
    "test"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node",
      "vitest/jsdom"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types",
      "../../@types"
    ]
  }
}
