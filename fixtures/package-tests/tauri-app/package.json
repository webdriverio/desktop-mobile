{
  "name": "tauri-app-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "clean:dist": "rm -rf dist",
    "build:js": "pnpm --filter @wdio/tauri-plugin build:js",
    "build:web": "node scripts/build-web.ts",
    "build": "pnpm build:js && pnpm build:web && tauri build --debug",
    "test": "cross-env DEBUG=@wdio/tauri-service wdio run wdio.conf.ts",
    "test:embedded": "cross-env DEBUG=@wdio/tauri-service wdio run wdio.embedded.conf.ts",
    "test:browser": "cross-env DEBUG=@wdio/tauri-service wdio run wdio.browser.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-log": "2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-service": "workspace:*",
    "typescript": "^6.0.3"
  }
}
