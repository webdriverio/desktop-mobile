{
  "name": "electron-builder-app-example-esm",
  "version": "0.0.0",
  "description": "Electron Builder app example using wdio-electron-service (ESM)",
  "main": "dist/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "pnpx shx rm -rf dist dist-electron node_modules",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "start": "electron .",
    "test": "cross-env DEBUG=wdio-electron-service wdio run wdio.conf.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/electron-service": "workspace:*",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "electron",
    "builder",
    "electron-vite",
    "webdriverio",
    "testing",
    "example"
  ],
  "author": "WebDriverIO Community",
  "license": "MIT",
  "build": {
    "appId": "com.example.builder-app",
    "productName": "Builder App Example",
    "executableName": "builder-app-example",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir",
      "identity": null
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
