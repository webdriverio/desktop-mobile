{
  "name": "electron-forge-app-example-cjs",
  "version": "0.0.0",
  "description": "Electron Forge app example using wdio-electron-service (CJS)",
  "main": "dist/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "pnpx shx rm -rf dist dist-electron node_modules",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-forge package",
    "preview": "electron-vite preview",
    "start": "electron .",
    "test": "cross-env DEBUG=wdio-electron-service wdio run wdio.conf.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/electron-service": "workspace:*",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/native-types": "workspace:*",
    "@wdio/native-utils": "workspace:*",
    "@wdio/spec-reporter": "^10.1.0",
    "cross-env": "^10.1.0",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "electron",
    "forge",
    "electron-vite",
    "webdriverio",
    "testing",
    "example"
  ],
  "author": "WebDriverIO Community",
  "license": "MIT",
  "config": {
    "forge": {
      "outDir": "dist-electron",
      "packagerConfig": {
        "osxSign": false,
        "prune": false
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "forge_app_example"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
